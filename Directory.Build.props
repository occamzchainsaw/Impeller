<Project>

  <!--
    Settings shared by every project in the solution.
    Per-project overrides belong in the .csproj, not here.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are errors in CI; locally they stay warnings so a work-in-progress build still runs. -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic builds so binaries are reproducible. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. We document public API selectively, not exhaustively. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Product>Impeller</Product>
    <Company>Impeller</Company>
    <Authors>occamzchainsaw</Authors>
    <Copyright>Public domain (Unlicense)</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/occamzchainsaw/Impeller</RepositoryUrl>
    <PackageProjectUrl>https://github.com/occamzchainsaw/Impeller</PackageProjectUrl>

    <!--
      Public domain. Set here rather than per-project so a package added later cannot end up
      published under different terms than the repository it came from, purely by omission.
    -->
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>

    <!--
      Off by default, on for the two plugin packages only. The engine, the shell and the hardware
      backend are applications; a stray package of one of them would be a name claimed by accident
      on nuget.org, and a claimed name cannot be given back.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Central versioning. Bump here; every assembly follows.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.6</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
  </PropertyGroup>

</Project>
