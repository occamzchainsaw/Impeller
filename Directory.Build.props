<Project>

  <!--
    Settings shared by every project in the solution.
    Per-project overrides belong in the .csproj, not here.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are errors in CI; locally they stay warnings so a work-in-progress build still runs. -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic builds so binaries are reproducible. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. We document public API selectively, not exhaustively. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Product>Impeller</Product>
    <Company>Impeller</Company>
    <Authors>Impeller contributors</Authors>
    <Copyright>Copyright (c) Impeller contributors</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Central versioning. Bump here; every assembly follows.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
  </PropertyGroup>

</Project>
