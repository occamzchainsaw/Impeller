<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The samples restore the SDK as a package from a folder feed rather than as a project
    reference, on purpose. A project reference would hide every rough edge an outside author
    actually hits - a missing dependency in the nuspec, a type that is internal, an XML doc file
    that never made it into the package - and the whole point of the sample is to be the first
    consumer who is not inside this solution.

    Run scripts/pack-sdk.ps1 to fill the feed.
  -->
  <packageSources>
    <clear />
    <add key="impeller-local" value="..\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
