<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Impeller.App.Shell</RootNamespace>
    <AssemblyName>Impeller</AssemblyName>
    <Description>Impeller desktop shell.</Description>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Without this the executable carries no icon at all, so Explorer, the taskbar and Alt+Tab all
      fall back to the generic one. Assets\AppIcon.ico is the same file the window and the
      notification area load at runtime.
    -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!--
      No <Platforms> list. With one, a solution-level build picks the solution's default
      platform and quietly produces an x86 shell, while building this project alone produces
      x64. The runtime identifier follows the build machine instead, and a cross-architecture
      build is an explicit -r on the command line.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Unpackaged, per the portable-deployment decision: unzip a folder and run it, the way
    FanControl is distributed. MSIX could not install the engine service anyway, so packaging
    would have bought identity at the cost of requiring a signing certificate.

    WindowsAppSDKSelfContained carries the WinUI runtime in the output folder. Without it the
    app refuses to start unless the machine already has the Windows App SDK runtime installed,
    which defeats the point of a portable build.
  -->
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!--
      Trimming stays off. WinUI resolves types by name from XAML at runtime, so the trimmer
      cannot see those references and silently removes types the UI needs. The failure shows up
      as a crash on navigation in Release only, which is the worst possible place to find it.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    Publishing to a folder drops the project's own .pri, and nothing says so. dotnet publish -o
    copies the framework PRIs - Microsoft.UI.pri and friends - but the one holding this app's
    compiled XAML is copied by a target keyed to the build output directory, which a custom publish
    directory is not. The published app then starts, gets as far as building its first window, and
    dies inside LoadComponent with a XamlParseException wrapped in a stowed WinRT exception: the
    Event Log names Microsoft.UI.Xaml.dll and exception code 0xc000027b, and says nothing about a
    missing file.

    Debug never showed it because bin\Debug is the build output directory, so the file is simply
    there. Only a published folder is affected, which makes this exactly the kind of fault that
    ships.
  -->
  <Target Name="PublishProjectPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Include="$(ProjectPriFullPath)"
        Condition="'$(ProjectPriFullPath)' != '' And Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Impeller.App.ViewModels\Impeller.App.ViewModels.csproj" />
    <ProjectReference Include="..\Impeller.Platform.Windows\Impeller.Platform.Windows.csproj" />
    <ProjectReference Include="..\Impeller.Core.Abstractions\Impeller.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
