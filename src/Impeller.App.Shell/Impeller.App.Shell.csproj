<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Impeller.App.Shell</RootNamespace>
    <AssemblyName>Impeller</AssemblyName>
    <Description>Impeller desktop shell.</Description>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      No <Platforms> list. With one, a solution-level build picks the solution's default
      platform and quietly produces an x86 shell, while building this project alone produces
      x64. The runtime identifier follows the build machine instead, and a cross-architecture
      build is an explicit -r on the command line.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Unpackaged, per the portable-deployment decision: unzip a folder and run it, the way
    FanControl is distributed. MSIX could not install the engine service anyway, so packaging
    would have bought identity at the cost of requiring a signing certificate.

    WindowsAppSDKSelfContained carries the WinUI runtime in the output folder. Without it the
    app refuses to start unless the machine already has the Windows App SDK runtime installed,
    which defeats the point of a portable build.
  -->
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!--
      Trimming stays off. WinUI resolves types by name from XAML at runtime, so the trimmer
      cannot see those references and silently removes types the UI needs. The failure shows up
      as a crash on navigation in Release only, which is the worst possible place to find it.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Impeller.App.ViewModels\Impeller.App.ViewModels.csproj" />
    <ProjectReference Include="..\Impeller.Platform.Windows\Impeller.Platform.Windows.csproj" />
    <ProjectReference Include="..\Impeller.Core.Abstractions\Impeller.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
