<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.CurvesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Impeller.App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

            <!--
                The same shape the Sensors page uses: pick what kind of thing to make, then fill it
                in on a panel. A curve was the odd one out, edited beside the list and driven by the
                selection.
            -->
            <DropDownButton
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="New curve">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="OnAddGraph" Text="Graph — points you place" />
                        <MenuFlyoutItem Click="OnAddLinear" Text="Linear — a straight ramp" />
                        <MenuFlyoutItem Click="OnAddAuto" Text="Auto — holds a target temperature" />
                        <MenuFlyoutItem Click="OnAddTrigger" Text="Trigger — two speeds" />
                        <MenuFlyoutItem Click="OnAddFlat" Text="Flat — one speed" />
                        <MenuFlyoutItem Click="OnAddMix" Text="Mix — combines other curves" />
                        <MenuFlyoutItem Click="OnAddSync" Text="Sync — follows another fan" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">

                <StackPanel
                    Padding="0,24,0,0"
                    Spacing="6"
                    Visibility="{x:Bind local:CurvesPage.When(ViewModel.IsEmpty), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No curves yet." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Use New curve to make one. A curve turns a temperature into a fan speed; the Dashboard is where you point a fan at it."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Curves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CurveListItemViewModel">
                            <Border
                                Margin="0,0,0,8"
                                Padding="16,12,16,12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Summary, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ReadsText, Mode=OneWay}" />
                                    </StackPanel>

                                    <!--  What it is asking for, so the page says which curves are doing anything.  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="90"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind OutputText, Mode=OneWay}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="asking for"
                                            TextAlignment="Right" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="OnEditCurve"
                                            Content="Edit"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Click="OnDeleteCurve"
                                            Content="Delete"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
