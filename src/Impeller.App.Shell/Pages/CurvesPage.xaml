<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.CurvesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Impeller.App.Shell.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sensors="using:Impeller.App.ViewModels.Sensors"
    xmlns:vm="using:Impeller.App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  The list of curves, and the one control that makes a new one.  -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Curves}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CurveListItemViewModel">
                        <StackPanel Padding="0,6,0,6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind local:CurvesPage.DescribeCurve(Kind, Users), Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <DropDownButton
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Content="New curve">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OnAddGraph" Text="Graph — points you place" />
                        <MenuFlyoutItem Click="OnAddLinear" Text="Linear — a straight ramp" />
                        <MenuFlyoutItem Click="OnAddAuto" Text="Auto — holds a target temperature" />
                        <MenuFlyoutItem Click="OnAddTrigger" Text="Trigger — two speeds" />
                        <MenuFlyoutItem Click="OnAddFlat" Text="Flat — one speed" />
                        <MenuFlyoutItem Click="OnAddMix" Text="Mix — combines other curves" />
                        <MenuFlyoutItem Click="OnAddSync" Text="Sync — follows another fan" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="14">

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Select a curve, or make one."
                    Visibility="{x:Bind local:CurvesPage.WhenNull(ViewModel.Editor), Mode=OneWay}" />

                <StackPanel Spacing="14" Visibility="{x:Bind local:CurvesPage.WhenNotNull(ViewModel.Editor), Mode=OneWay}">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="NameBox"
                            Header="Name"
                            TextChanged="OnEdited" />

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.RevertCommand}"
                            Content="Revert" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.DeleteCommand}"
                            Content="Delete" />
                    </Grid>

                    <!--  The canvas, for a graph curve. Everything else is numbers.  -->
                    <Border
                        Padding="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind local:CurvesPage.WhenGraph(ViewModel.Editor), Mode=OneWay}">
                        <StackPanel>
                            <controls:CurveCanvas x:Name="Canvas" Height="260" />
                            <TextBlock
                                Margin="8,0,8,6"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Click to add a point, drag to move it, right-click to remove it." />
                        </StackPanel>
                    </Border>

                    <!--  Shared numbers. Which of them mean anything depends on the kind, and the headers say which.  -->
                    <Grid
                        ColumnSpacing="12"
                        RowSpacing="12"
                        Visibility="{x:Bind local:CurvesPage.WhenNotGraph(ViewModel.Editor), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox
                            x:Name="LowInputBox"
                            Header="Lower temperature (°C)"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnEdited" />
                        <NumberBox
                            x:Name="HighInputBox"
                            Grid.Column="1"
                            Header="Upper temperature (°C)"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnEdited" />
                        <NumberBox
                            x:Name="MinimumDutyBox"
                            Grid.Row="1"
                            Header="Lower duty (%)"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnEdited" />
                        <NumberBox
                            x:Name="MaximumDutyBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="Upper duty (%)"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnEdited" />
                    </Grid>

                    <!--  The picker. 193 sensors is not a dropdown, so it is a searchable tree.  -->
                    <StackPanel Spacing="8" Visibility="{x:Bind local:CurvesPage.WhenReadsASensor(ViewModel.Editor), Mode=OneWay}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Reads" />

                        <AutoSuggestBox
                            PlaceholderText="Search sensors"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SensorPicker.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--
                            Expanders rather than a TreeView: the shape is exactly two levels deep and
                            never grows a third, and a TreeView costs a node graph built in code to
                            express that.
                        -->
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SensorPicker.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sensors:SensorGroupViewModel">
                                        <Expander
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Header="{x:Bind Name}">
                                            <ItemsControl ItemsSource="{x:Bind Sensors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sensors:SensorItemViewModel">
                                                        <RadioButton
                                                            Checked="OnSensorChosen"
                                                            Content="{x:Bind local:CurvesPage.DescribeSensor(Name, ValueText), Mode=OneWay}"
                                                            GroupName="CurveSource" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
