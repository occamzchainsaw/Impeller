<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

        <InfoBar
            Grid.Row="1"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
            Severity="Informational"
            Title="Engine" />
    </Grid>
</Page>
