<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Impeller.App.ViewModels.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:DashboardPage.SensorSummary(ViewModel.SensorCount), Mode=OneWay}" />

            <!--  Every fan the engine can see that is not already on this page.  -->
            <DropDownButton
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="Add a fan">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="AvailableFans" Opening="OnAvailableOpening" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!--  A configuration with no fans in it needs a sentence, not a blank panel.  -->
        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Top"
            Spacing="6"
            Visibility="{x:Bind local:DashboardPage.When(ViewModel.IsEmpty), Mode=OneWay}">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No fans yet." />
            <TextBlock
                MaxWidth="560"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Use Add a fan to bring one of this machine's headers onto the page. It arrives switched off; give it a curve to start driving it."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            ItemsRepeater rather than ItemsControl, so only the tiles on screen are built. The list
            it replaces materialised every control whether it was visible or not.
        -->
        <ScrollViewer Grid.Row="2" Visibility="{x:Bind local:DashboardPage.WhenNot(ViewModel.IsEmpty), Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Controls}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemWidth="320"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="controls:ControlCardViewModel">
                        <!--
                            Every control here that raises an event rather than binding a command
                            carries its card in Tag. The handlers used to read DataContext, which
                            inside an ItemsRepeater template is not something to depend on: the
                            cards rendered perfectly - x:Bind resolves against the item directly and
                            never consults it - while the mode switch and the name box's Enter and
                            focus-loss handlers silently did nothing at all. Identify was the one
                            control that kept working, because it is bound to a command.
                        -->
                        <Border Padding="16,14,16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel Spacing="10">

                                <!--  Name, and the way to work out which fan it physically is.  -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        A text box that reads as a label until it is clicked. The
                                        name is the one thing on this card a person wants to change
                                        and never thinks of as a setting, so it should not be behind
                                        a dialog.
                                    -->
                                    <TextBox
                                        MinHeight="0"
                                        Margin="-8,0,0,0"
                                        Padding="8,4,8,4"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        GotFocus="OnNameFocused"
                                        KeyDown="OnNameKeyDown"
                                        LostFocus="OnNameCommitted"
                                        MaxLength="64"
                                        Tag="{x:Bind}"
                                        Text="{x:Bind EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTipService.ToolTip="{x:Bind local:DashboardPage.Where(ProviderName, HardwareName, HardwarePath), Mode=OneWay}" />

                                    <!--
                                        A warning glyph rather than an InfoBar, and the reason is
                                        the layout: UniformGridLayout gives every card the height of
                                        the first one it measures, so anything that appears inside a
                                        card and makes it taller is simply cut off. An InfoBar here
                                        showed as ten pixels of coloured edge with the message
                                        invisible below it. Every card is now the same height by
                                        construction, and the two things that used to open a bar say
                                        what they have to say elsewhere: this in a tooltip, and a
                                        failed click in the notification centre, which is where the
                                        rest of the app already reports its failures.
                                    -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <FontIcon
                                            AutomationProperties.Name="The engine cannot see this fan"
                                            FontSize="15"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            ToolTipService.ToolTip="This fan is in the configuration but the engine cannot see it. Its settings are kept."
                                            Visibility="{x:Bind local:DashboardPage.WhenNot(IsPresent)}" />

                                        <!--
                                            Both stretch, so the shorter one grows to the taller.
                                            A glyph and a word do not measure the same height, and
                                            in a horizontal StackPanel each child otherwise keeps
                                            its own - which left the bin button visibly squat
                                            beside Identify. Stretch rather than a fixed height, so
                                            it still holds at other text sizes and scalings.
                                        -->
                                        <Button
                                            VerticalAlignment="Stretch"
                                            Command="{x:Bind IdentifyCommand}"
                                            Content="Identify"
                                            IsEnabled="{x:Bind IsPresent}"
                                            ToolTipService.ToolTip="Spin this fan up for five seconds" />

                                        <!--  Named, because a button whose only content is a glyph announces nothing.  -->
                                        <Button
                                            Padding="10,0,10,0"
                                            VerticalAlignment="Stretch"
                                            AutomationProperties.Name="Remove this fan"
                                            Click="OnRemoveFan"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Take this fan off the page">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!--  The two numbers, and who is deciding them.  -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{x:Bind DutyText, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SpeedText, Mode=OneWay}" />

                                    <!--
                                        On the same row rather than a line of its own: UniformGridLayout
                                        gives every card the height of the first it measures, so a row
                                        that appears on one card and not another is cut off on all of
                                        them. Empty when the fan got what was asked for, which is an
                                        Auto column occupying nothing.
                                    -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{x:Bind RequestedText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind RequestedDetail, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind HolderText, Mode=OneWay}"
                                        TextAlignment="Right"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind HolderText, Mode=OneWay}"
                                        Visibility="{x:Bind local:DashboardPage.WhenText(HolderText), Mode=OneWay}" />
                                </Grid>

                                <!--
                                    The curve picker is also the on switch: "Not driven" is one of
                                    the choices. Those were always one fact, and having two controls
                                    for it let a user set one and be surprised by the other.
                                -->
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    Header="Driven by"
                                    IsEnabled="{x:Bind IsPresent}"
                                    ItemsSource="{x:Bind Curves, Mode=OneWay}"
                                    SelectedItem="{x:Bind SelectedCurve, Mode=TwoWay}" />

                                <!--  Curve or Manual: labelled by what drives the fan, not by what the control does.  -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleSwitch
                                        MinWidth="0"
                                        IsEnabled="{x:Bind CanTakeByHand, Mode=OneWay}"
                                        IsOn="{x:Bind WantsManual, Mode=TwoWay}"
                                        OffContent="{x:Bind ModeOffLabel, Mode=OneWay}"
                                        OnContent="Manual"
                                        ToolTipService.ToolTip="Drive this fan by hand. It does not need a curve." />

                                    <!--  Dead unless the user holds the fan. A slider that silently does nothing is worse than none.  -->
                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind IsPinned, Mode=OneWay}"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind PinDuty, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind local:DashboardPage.Percent(PinDuty), Mode=OneWay}"
                                        TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
