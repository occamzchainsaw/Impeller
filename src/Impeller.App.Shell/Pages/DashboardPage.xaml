<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Impeller.App.ViewModels.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

            <!--  The two numbers worth seeing without reading anything: how hot it is, and how much is being watched.  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.HottestTemperature, Mode=OneWay}"
                    ToolTipService.ToolTip="Hottest temperature reported" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind local:DashboardPage.SensorSummary(ViewModel.SensorCount), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Informational while connected, a warning when not: fans going unmanaged is not a neutral state.  -->
        <InfoBar
            Grid.Row="1"
            Title="Engine"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
            Severity="{x:Bind local:DashboardPage.SeverityFor(ViewModel.IsConnected), Mode=OneWay}" />

        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind local:DashboardPage.HasText(ViewModel.Problem), Mode=OneWay}"
            Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
            Severity="Error" />

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Controls}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:ControlCardViewModel">
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,12,16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind OwnerText, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="64"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind DutyText, Mode=OneWay}"
                                        TextAlignment="Right" />

                                    <TextBlock
                                        Grid.Column="2"
                                        MinWidth="88"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SpeedText, Mode=OneWay}"
                                        TextAlignment="Right" />

                                    <!--  Identify sits on the card rather than behind a menu: working out which fan is which is the first thing anyone does.  -->
                                    <StackPanel
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ToggleSwitch
                                            MinWidth="0"
                                            IsOn="{x:Bind IsDriven, Mode=OneWay}"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="OnDrivenToggled"
                                            ToolTipService.ToolTip="Whether the engine drives this fan" />
                                        <Button
                                            Command="{x:Bind IdentifyCommand}"
                                            Content="Identify"
                                            ToolTipService.ToolTip="Spin this fan up for five seconds" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Command="{x:Bind PinCommand}"
                                        Content="Hold by hand"
                                        IsEnabled="{x:Bind local:DashboardPage.Not(IsHeldElsewhere), Mode=OneWay}" />

                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind PinDuty, Mode=TwoWay}" />

                                    <Button
                                        Grid.Column="2"
                                        Command="{x:Bind ReleaseCommand}"
                                        Content="Back to curve"
                                        IsEnabled="{x:Bind IsPinned, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
