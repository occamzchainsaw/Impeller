<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Impeller.App.Shell.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstractions="using:Impeller.Core.Abstractions"
    xmlns:config="using:Impeller.Core.Abstractions.Configuration"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Impeller.App.Shell.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

            <!--  Configurations: switch, copy, remove.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Configurations"
                IsExpanded="True">
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="A configuration holds every curve and everything each fan is set to. One runs at a time, and switching to another takes effect straight away."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind local:SettingsPage.Running(ViewModel.CurrentConfiguration), Mode=OneWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Configurations}"
                            SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" />

                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.LoadCommand}"
                            Content="Switch to it"
                            Style="{StaticResource AccentButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.DeleteCommand}"
                            Content="Delete" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            PlaceholderText="New name"
                            Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.SaveAsCommand}"
                            Content="Save a copy and switch to it" />
                    </Grid>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind local:SettingsPage.SavedIn(ViewModel.ConfigurationRoot), Mode=OneWay}" />
                </StackPanel>
            </Expander>

            <!--  Import. Saved, not applied: the notes are the reason for importing rather than guessing.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Bring a FanControl configuration across">
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pick FanControl's userConfig.json, or a file from its Configurations folder. It is read and never changed, and the result is saved without being applied."
                        TextWrapping="Wrap" />

                    <Button Command="{x:Bind ViewModel.ImportCommand}" Content="Choose a file…" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ImportNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="config:ImportNote">
                                <Grid Padding="0,3,0,3" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        MinWidth="80"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Outcome}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinWidth="140"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Subject}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Message}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!--  The two procedures that measure the machine. Both take minutes and take over the fans.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Measure the fans">
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Both take several minutes and drive every fan while they run. Pair first: calibrating a fan means changing its speed and watching what happens, so Impeller has to know which speed reading belongs to which header."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Command="{x:Bind ViewModel.PairAllCommand}"
                            Content="Pair fans with headers"
                            IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.Tuning.IsRunning), Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.CalibrateAllCommand}"
                            Content="Calibrate every fan"
                            IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.Tuning.IsRunning), Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.Tuning.CancelCommand}"
                            Content="Stop"
                            IsEnabled="{x:Bind ViewModel.Tuning.IsRunning, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6" Visibility="{x:Bind local:SettingsPage.WhenTrue(ViewModel.Tuning.IsRunning), Mode=OneWay}">
                        <ProgressBar Maximum="1" Value="{x:Bind ViewModel.Tuning.Progress, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Tuning.Stage, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Tuning.Detail, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.Tuning.Summary, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:SettingsPage.HasTextVisibility(ViewModel.Tuning.Summary), Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tuning.Outcomes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="abstractions:TuningOutcome">
                                <Grid Padding="0,3,0,3" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        MinWidth="180"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ControlName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Message}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!--  Starting with Windows, which is about the window and not about the fans.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Starting with Windows">
                <StackPanel Spacing="12">
                    <!--
                        Says what it does not do as well as what it does. The obvious reading of a
                        "start with Windows" switch on a fan controller is that the fans stop being
                        managed without it, which would make switching it off frightening and is
                        the opposite of true.
                    -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Your fans are managed by the Impeller engine, which is a Windows service: it starts with the machine and keeps running whether this window is open or not, and whether anyone is logged in or not. This setting only decides whether the window and its tray icon come back when you log in."
                        TextWrapping="Wrap" />

                    <ToggleSwitch
                        Header="Open Impeller when I log in"
                        IsOn="{x:Bind ViewModel.StartsWithWindows, Mode=TwoWay}"
                        OffContent="No"
                        OnContent="Yes" />

                    <!--
                        Greyed out until there is a log-in launch to describe. The preference is
                        stored as an argument on that launch, so switching the one above off takes
                        it with it - and a switch that appears to remember something it cannot is
                        worse than one that is plainly unavailable.
                    -->
                    <ToggleSwitch
                        Header="Start minimised"
                        IsEnabled="{x:Bind ViewModel.StartsWithWindows, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.StartsMinimised, Mode=TwoWay}"
                        OffContent="No"
                        OnContent="Yes" />

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Listed in Task Manager under Startup apps, where you can also switch it off. Starting Impeller yourself always opens the window, however these are set."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!--  Which version this is, and whether there is a newer one.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Version and updates">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.AppVersion}" />

                    <!--
                        Says exactly what leaves the machine, because "checks for updates" is a
                        phrase people have learned to distrust for reasons that do not apply here.
                    -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Impeller can ask the public releases page whether a newer version exists. It is one request and it sends nothing about you or this machine — no identifier, no version, nothing that separates you from anyone else asking. It never downloads or installs anything; updating is always you running the installer."
                        TextWrapping="Wrap" />

                    <ToggleSwitch
                        Header="Check when Impeller starts"
                        IsOn="{x:Bind ViewModel.ChecksForUpdates, Mode=TwoWay}"
                        OffContent="No"
                        OnContent="Yes" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Content="Check now" />
                        <HyperlinkButton
                            Command="{x:Bind ViewModel.OpenReleaseCommand}"
                            Content="Open the release page"
                            Visibility="{x:Bind local:SettingsPage.WhenFound(ViewModel.Available), Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:SettingsPage.HasTextVisibility(ViewModel.UpdateStatus), Mode=OneWay}" />

                    <!--
                        The engine is the half that needs administrator, and a window updated
                        without it stops being able to talk to it. The installer does both.
                    -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The installer updates the engine service and this window together. Updating one without the other leaves them unable to talk, which Impeller will tell you about rather than leaving you to work out."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!--  The document that goes on a bug report.  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Diagnostics">
                <StackPanel Spacing="12">
                    <!--
                        The last clause is the one that matters. A button labelled only "Collect",
                        on a fan controller running as LocalSystem, invites the wrong assumption.
                    -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Collects a report of what Impeller can see — engine version, hardware detected, the loaded configuration, recent errors — for attaching to a bug report. It is copied to the clipboard and sent nowhere."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.CollectDiagnosticsCommand}" Content="Collect the report" />
                        <Button
                            Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                            Content="Copy to clipboard"
                            IsEnabled="{x:Bind local:SettingsPage.HasText(ViewModel.Diagnostics), Mode=OneWay}" />
                    </StackPanel>

                    <TextBox
                        MaxHeight="320"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.Diagnostics, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Visibility="{x:Bind local:SettingsPage.HasTextVisibility(ViewModel.Diagnostics), Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
