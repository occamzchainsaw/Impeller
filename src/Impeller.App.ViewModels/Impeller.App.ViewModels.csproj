<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately no UI-framework reference. Everything here is plain observable objects, so
      the same view models could be driven by an Avalonia shell without being rewritten.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>Presentation-layer view models, independent of any UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Impeller.Core.Abstractions\Impeller.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Impeller.Ipc.Contracts\Impeller.Ipc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Impeller.Core.Engine.Tests" />
  </ItemGroup>

</Project>
