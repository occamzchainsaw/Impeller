<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Hosts the hardware layer, so it inherits the Windows-only target. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dotnet-Impeller.EngineService-9a6b97a2-96e2-4110-b70a-8d0dab3da35a</UserSecretsId>
    <Description>Elevated headless engine: owns the tick loop, hardware access, and the plugin host.</Description>
    <!-- Required by [LibraryImport]: the generated P/Invoke marshalling for the Service Control
         Manager uses pointers. No hand-written unsafe code exists in this project. -->
  </PropertyGroup>

  <!--
    Publish settings, on Release only. A self-contained Debug build would put a copy of the runtime
    in bin\Debug for no gain, and the debug engine is the one a developer registers with the SCM
    while working - making that folder heavier makes every incremental build slower.

    Self-contained because the engine is a service installed from a folder the user chose, and a
    service that fails to start because the machine has no matching .NET runtime fails at boot, with
    the fans unmanaged, and reports it in the event log rather than anywhere a person is looking.

    Trimming stays off. The hardware layer resolves LibreHardwareMonitor types reflectively and
    StreamJsonRpc builds its proxies at runtime; a trimmed build breaks in the tick loop, on someone
    else's machine, which is not a saving.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Impeller.Core.Engine\Impeller.Core.Engine.csproj" />
    <ProjectReference Include="..\Impeller.Core.Persistence\Impeller.Core.Persistence.csproj" />
    <ProjectReference Include="..\Impeller.Hardware.Adlx\Impeller.Hardware.Adlx.csproj" />
    <ProjectReference Include="..\Impeller.Hardware.Lhm\Impeller.Hardware.Lhm.csproj" />
    <ProjectReference Include="..\Impeller.Plugins.Host\Impeller.Plugins.Host.csproj" />
    <ProjectReference Include="..\Impeller.Ipc.Contracts\Impeller.Ipc.Contracts.csproj" />
    <ProjectReference Include="..\Impeller.Platform.Windows\Impeller.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
