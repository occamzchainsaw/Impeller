{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Impeller": "Information"
      }
    }
  },
  "Engine": {
    "TickInterval": "00:00:01",
    "FailsafeOnShutdown": true
  },
  "Hardware": {
    "Lhm": {
      "EnableMotherboard": true,
      "EnableCpu": true,
      "EnableGpu": true,
      "EnableStorage": true,
      "EnableCooler": true,
      "EnableEmbeddedController": true,
      "EnablePsu": true,
      "EnableMemory": false,
      "EnableNetwork": false,
      "EnableBattery": false,
      "SlowPollInterval": "00:01:00"
    }
  }
}
