<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately references nothing.

    This is what a third-party plugin takes a permanent dependency on, so every reference added
    here is one an author cannot get rid of. Referencing Impeller.Core.Abstractions — which it used
    to — would have dragged the whole configuration model into that surface: curve definitions,
    calibration tables, provider interfaces, the identity map. A plugin that wants to drive a fan
    should not have to take a version dependency on what a curve is.

    The cost is a small translation layer in Impeller.Plugins.Host. It is the right side to pay on.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Packed separately from the SDK rather than folded into it, because it is genuinely a separate
    thing: the SDK is one implementation of this contract, and someone writing a plugin in another
    language - or with their own transport - needs the wire vocabulary without the client.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Impeller.Plugins.Abstractions</PackageId>
    <Title>Impeller plugin contracts</Title>
    <Description>The wire contract between the Impeller engine and a plugin: manifest, capabilities, admission, and the two JSON-RPC interfaces. References nothing. Most authors want Impeller.Plugins.Sdk instead.</Description>
    <PackageTags>impeller;fan;fancontrol;hardware;plugin</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
